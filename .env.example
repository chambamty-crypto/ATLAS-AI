# Local AI mode: no OpenAI API key is required.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Optional: set AI_PROVIDER=openai and add a server-side key to use OpenAI instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
PORT=3000

# Persistent SQLite database (mount this directory on your host)
ATLAS_DB_PATH=./data/atlas.sqlite

# Public application origin used in verification and password-reset links
APP_URL=http://localhost:3000
# SMTP account used only by the server to send account emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
