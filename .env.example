# Create an API key in your OpenAI dashboard and keep it server-side.
OPENAI_API_KEY=
PORT=3000
OPENAI_MODEL=gpt-5.4
# Persistent SQLite database (mount this directory on your host)
ATLAS_DB_PATH=./data/atlas.sqlite

# Public application origin used in verification and password-reset links
APP_URL=http://localhost:3000
# SMTP account used only by the server to send account emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
