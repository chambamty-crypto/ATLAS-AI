index cf17614..fc739e3 100644
--- a/src/atlas-tools.mjs
+++ b/src/atlas-tools.mjs
@@ -195,8 +195,11 @@ export function executeAtlasTool(name, args = {}, now = new Date()) {
   }
 
   if (name === "convert_units") {
-    const result = convertUnits(args);
-    return { ok: true, ...args, result };
+    // Realtime no aplica el modo estricto: acepta números enviados como texto ("5").
+    const value = typeof args.value === "string" && args.value.trim() !== "" ? Number(args.value) : args.value;
+    const { category, from_unit, to_unit } = args;
+    const result = convertUnits({ category, value, from_unit, to_unit });
+    return { ok: true, category, value, from_unit, to_unit, result };
   }
 
   throw new Error("La herramienta solicitada no está autorizada.");
diff --git a/test/atlas-tools.test.mjs b/test/atlas-tools.test.mjs
index 3f210e5..dac3d34 100644
--- a/test/atlas-tools.test.mjs
+++ b/test/atlas-tools.test.mjs
@@ -54,3 +54,8 @@ test("Realtime comparte las herramientas pero omite strict", () => {
   assert.deepEqual(ATLAS_REALTIME_TOOLS.map((tool) => tool.name), ATLAS_TOOL_NAMES);
   assert.ok(ATLAS_REALTIME_TOOLS.every((tool) => tool.type === "function" && !("strict" in tool)));
 });
+
+test("convert_units acepta números como texto y no refleja campos ajenos", () => {
+  const result = executeAtlasTool("convert_units", { category: "longitud", value: "1", from_unit: "km", to_unit: "m", ok: false, extra: "x" });
+  assert.deepEqual(result, { ok: true, category: "longitud", value: 1, from_unit: "km", to_unit: "m", result: 1000 });
+});
